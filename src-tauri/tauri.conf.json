{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileSeal",
  "identifier": "org.fileseal.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "FileSeal",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "FileSeal",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Nikola-Putnik, MIT License",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "shortDescription": "Checks that files have not changed over time",
    "longDescription": "FileSeal records the hashes of files, in hash files next to them or in databases, and verifies later that their content has not changed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEMzIzODEwNTcxMzI2MTEKUldRUkpoTlhFRGd5emJmNWlQK2RjY3NBWHZDOTErZ0tDeHphV3dDQ2daWDJkVExSWlJlWTR2Y04K",
      "endpoints": [
        "https://github.com/Nikola-Putnik/FileSeal2/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
